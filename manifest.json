  ],
  "optionalMethods": [],
  "resources": [
    "ui/index.html",
    "ui/style.css",
    "ui/app.js",
    "ui/data.js",
    "ui/nous-plugin.js"
  ],
  "author": {
    "name": "liveldy",
    "url": "https://github.com/liveldy"
  },
  "changelog": [
    {
      "version": "1.0.0",
      "publishedAt": "2026-11-14",
      "changes": [
        "首个版本：CPU、GPU 各自一页，能力-成本图、排行与快照导入。",
        "随包携带离线快照，tools/snapshot.mjs 与定时任务每天刷新；页面不联网，读取最近一次快照。"
      ]
    }
  ]
}
