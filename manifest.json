{
  "id": "app.nous.hardware-cost",
  "name": "能力与成本-硬件",
  "version": "1.1.0",
  "api": "1.3",
  "requiresHost": "1.2.0",
  "description": "CPU 与 GPU 的能力-成本图和排行，看每美元买到多少性能。",
  "platforms": [
    "web",
    "windows-x64",
    "android-arm64"
  ],
  "permissions": [
    "storage"
  ],
  "entry": "ui/index.html",
  "icon": "data:image/svg+xml;base64,",
  "repository": "liveldy/Nous-Plugin-Hardware-Capability-Cost",
  "license": "MIT",
  "navigation": [
    {
      "id": "cpu",
      "label": "CPU",
      "icon": "cpu"
    },
    {
      "id": "gpu",
      "label": "GPU",
      "icon": "gpu"
    }
  ],
  "defaultView": "cpu",
  "requiredMethods": [
    "storage.get",
    "storage.set"
  ],
  "optionalMethods": [],
  "resources": [
    "ui/index.html",
    "ui/style.css",
    "ui/app.js",
    "ui/data.js",
    "ui/nous-plugin.js"
  ],
  "author": {
    "name": "liveldy",
    "url": "https://github.com/liveldy"
  },
  "changelog": [
    {
      "version": "1.1.0",
      "publishedAt": "2026-11-14",
      "changes": [
        "浅色主题底色改为白色，与宿主页面无缝衔接；灰色只留给图表底板，深色主题不变。",
        "图表改为圆点，并按点的疏密自动取舍型号标签：碰撞避让、能力高的优先，放不下就不放，缩放后能放更多。",
        "CPU、GPU 各扩到 104 款，排行列出全部，图表按能力只画前 100 款。",
        "图表支持缩放、拖拽与全屏：按钮、Ctrl/⌘ + 滚轮、双指捏合、拖拽平移，全屏含移动端安全区与回退方案；价格轴改为对数刻度，型号不再挤在左端。"
      ]
    },
    {
      "version": "1.0.0",
      "publishedAt": "2026-11-14",
      "changes": [
        "首个版本：CPU、GPU 各自一页，能力-成本图、排行与快照导入。",
        "随包携带离线快照，tools/snapshot.mjs 与定时任务每天刷新；页面不联网，读取最近一次快照。"
      ]
    }
  ]
}
